{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["esnext"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noEmit": true,
        "skipLibCheck": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "isolatedModules": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
}
