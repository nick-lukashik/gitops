{
    "name": "e2e",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26",
        "pnpm": ">=12"
    },
    "scripts": {
        "test": "playwright test",
        "test:failure": "E2E_SUITE=failure playwright test",
        "lint": "biome check .",
        "format": "biome check --write .",
        "typecheck": "tsc --noEmit",
        "verify": "pnpm lint && pnpm typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@playwright/test": "1.64.1",
        "@types/node": "26.6.6",
        "typescript": "7.0.2"
    }
}
